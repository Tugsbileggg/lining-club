# ──────────────────────────────────────────────────────────────
# Lining Club — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ──────────────────────────────────────────────────────────────

# ── Firebase Web SDK (client, admin auth UI) ──
# Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only — privileged) ──
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the full JSON as a single line, OR set FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences from the JSON; they are normalized at runtime.
FIREBASE_PRIVATE_KEY=
# Optional alternative: absolute path to serviceAccountKey.json (local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Lining Club

# ── Payments — QPay via Wire (reseller mode) ──────────────────
# The QPay connection lives on Wire (`operator: "qpay", mode: "reseller"`), so
# Wire settles under ITS merchant rights: there is no QPay username, password
# or invoice code in this app. Create the connection in the Wire dashboard
# (Project → Суваг), get it approved, sign the contract with ДАН, then copy the
# API key here. Until both values are set, QPay is hidden at checkout.
#
# WIRE_API_BASE_URL is the ORIGIN only — no path, no trailing slash. The code
# appends "/v1/operator_connections" itself. If Wire's docs quote a full URL
# like https://api.example.mn/v1/operator_connections, take the host part:
#   https://api.example.mn
# Unsure? `npm run check-wire -- https://api.example.mn` probes a candidate.
WIRE_API_BASE_URL=
WIRE_API_KEY=
# The `whsec_…` signing secret of your Wire webhook endpoint. Register the
# endpoint (Admin → Тохиргоо shows the URL to use) with the event
# `payment_intent.succeeded`; Wire returns the secret exactly once, at creation.
# Verified as HMAC-SHA256(secret, "<t>.<raw body>") against the
# `WirePayment-Signature: t=…,v1=…` header, with a 300s timestamp tolerance.
WIRE_WEBHOOK_SECRET=
# Optional. Defaults to `${NEXT_PUBLIC_SITE_URL}/api/payments/wire/webhook`.
# Set it to a tunnel URL (ngrok/cloudflared) in local development — Wire cannot
# reach localhost.
# WIRE_WEBHOOK_URL=

# ── Email ──────────────────────────────────────────────────────
# EMAIL_PROVIDER: "console" logs only (no real send); "resend" delivers via
# the Resend API. To go live: set EMAIL_PROVIDER=resend, add RESEND_API_KEY,
# and set EMAIL_FROM to an address on a domain verified in Resend.
EMAIL_PROVIDER=console
EMAIL_FROM="Lining Club <orders@example.com>"
# RESEND_API_KEY=
# Optional: copy of every new order is emailed here (store owner inbox).
# ORDER_NOTIFY_EMAIL=
